# Copy to local.properties (never commit it).
sdk.dir=/path/to/Android/Sdk

# Gemini (prototype only; a shipped app would call the model through a backend).
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.5-flash-lite
# Optional: GEMINI_TALK_MODEL_ID (default gemini-3.5-flash), for the spoken conversation

# Sarvam voice (speech to text and text to speech). Without a key, the phone's own speech and voice are used.
SARVAM_API_KEY=
# Optional: SARVAM_STT_MODEL (default saaras:v4), SARVAM_TTS_MODEL (default bulbul:v3), SARVAM_TTS_SPEAKER (default simran)

# Optional release signing. Without these, the release build is signed with the debug key.
RELEASE_STORE_FILE=
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=
